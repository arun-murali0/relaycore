{
  "name": "relaycore",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-tenant webhook delivery service",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --exclude tests/integration/**",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "jshashes": "^1.0.8",
    "mongoose": "^8.24.4",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
