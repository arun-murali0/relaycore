{
  "name": "relaycore",
  "version": "0.1.0",
  "description": "Multi-tenant webhook delivery service",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run tests/unit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "web:dev": "pnpm --filter relaycore-web dev",
    "web:build": "pnpm --filter relaycore-web build",
    "infra:up:localdb": "docker compose --profile local-db up -d",
    "demo": "tsx --env-file=.env scripts/demo.ts"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^8.24.4",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  }
}
